# Copy this file to .env and replace every value.
PORT=3000
NODE_ENV=development

# Generate a long random value for production.
JWT_SECRET=replace-with-a-long-random-secret

# The first admin account is created on first server start if no admin exists.
ADMIN_NAME=Institute Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Optional production CORS origin. Leave blank when frontend is served by this Express app.
CORS_ORIGIN=
